{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/core.async {:mvn/version "1.9.865"}
        manifold/manifold {:mvn/version "0.5.0"}
        com.github.ben-manes.caffeine/caffeine {:mvn/version "3.2.4"}}

 ;for more examples of aliases see: https://github.com/seancorfield/dot-clojure
 :aliases
 {:clojure-1.11 {:extra-deps {org.clojure/clojure {:mvn/version "1.11.4"}}}
  :clojure-1.12 {:extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}}}

  :core.async-1.8 {:extra-deps {org.clojure/core.async {:mvn/version "1.8.741"}}}
  :core.async-1.9 {:extra-deps {org.clojure/core.async {:mvn/version "1.9.865"}}}

  :dev {:extra-paths ["dev"]
        :extra-deps {reloaded.repl/reloaded.repl {:mvn/version "0.2.4"}
                     criterium/criterium {:mvn/version "0.4.6"}}}

  :app {:extra-paths ["app"]
        :extra-deps {com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}}

  :clj-kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.07.24"}}
              :main-opts ["-m" "clj-kondo.main"]}

  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      org.slf4j/slf4j-simple {:mvn/version "2.0.18"}}}

  :runner {:main-opts ["-e" "(println \"warn-on-reflection =\" (set! *warn-on-reflection* true))"
                       "-m" "kaocha.runner"]
           :exec-fn   kaocha.runner/exec-fn}

  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                      cider/cider-nrepl {:mvn/version "0.62.2"}}
         :main-opts ["-e" "(println \"warn-on-reflection =\" (set! *warn-on-reflection* true))"
                     "-m" "nrepl.cmdline" "--interactive"
                     "--middleware" "[\"cider.nrepl/cider-middleware\"]"]}

  :deps-antq {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
              :main-opts ["-m" "antq.core"]}

  :format-fix {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
               :main-opts ["-m" "cljfmt.main" "fix" "src" "dev"]}

  :format-check {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                 :main-opts ["-m" "cljfmt.main" "check" "src" "dev"]}

  :jar {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
        :exec-fn hf.depstar/jar}

  :uberjar {:replace-deps {com.github.seancorfield/depstar {:mvn/version "2.1.303"}}
            :exec-fn hf.depstar/uberjar
            :exec-args {:aot true
                        :aliases [:app]
                        :main-class futurama.main}}

  :install-maven {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                  :exec-fn deps-deploy.deps-deploy/deploy
                  :exec-args {:installer :local
                              :artifact "build/futurama.jar"}}

  :deploy-maven {:replace-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                 :exec-fn deps-deploy.deps-deploy/deploy
                 :exec-args {:installer :remote
                             :artifact "build/futurama.jar"}}}
 :mvn/repos
 {"central" {:url "https://repo1.maven.org/maven2/"}
  "clojars" {:url "https://repo.clojars.org/"}}}
